# This file documents variable names only. Copy values into your environment or
# an ignored .env file; never place production secrets in a repository file.

# Optional local PostgreSQL container overrides. The checked-in Compose defaults
# are deliberately local-only and are not production credentials.
B2B_LOCAL_DB_NAME=online_store
B2B_LOCAL_DB_USERNAME=online_store
B2B_LOCAL_DB_PASSWORD=local-development-only

# Required when the application is not using its local Docker Compose service
# connection. Leave secrets empty in this example.
B2B_DB_JDBC_URL=
B2B_DB_USERNAME=
B2B_DB_PASSWORD=

# Local mail delivery is disabled by default.
B2B_MAIL_DELIVERY_ENABLED=false
B2B_MAIL_FROM_ADDRESS=no-reply@example.test
B2B_MAIL_HOST=localhost
B2B_MAIL_PORT=1025
B2B_MAIL_USERNAME=
B2B_MAIL_PASSWORD=
B2B_MAIL_SMTP_AUTH=false
B2B_MAIL_STARTTLS_ENABLED=false
B2B_MAIL_STARTTLS_REQUIRED=false
B2B_MAIL_SSL_ENABLED=false
B2B_MAIL_CONNECTION_TIMEOUT_MILLIS=5000
B2B_MAIL_READ_TIMEOUT_MILLIS=10000
B2B_MAIL_WRITE_TIMEOUT_MILLIS=10000

B2B_IMAGE_STORAGE_ROOT=./var/sku-images
B2B_BASE_URL=http://localhost:8080
B2B_SESSION_COOKIE_NAME=B2BSESSION
B2B_SESSION_COOKIE_SECURE=false

B2B_LOGIN_THROTTLE_MAX_FAILURES=5
B2B_LOGIN_THROTTLE_WINDOW=15m
B2B_LOGIN_THROTTLE_BLOCK_DURATION=15m
B2B_LOGIN_THROTTLE_RETENTION=24h

# Bootstrap is an explicit one-time administrator seed. Keep it disabled and
# credentials empty in this example; enable it only through deployment secrets.
B2B_BOOTSTRAP_ADMIN_ENABLED=false
B2B_BOOTSTRAP_ADMIN_EMAIL=
B2B_BOOTSTRAP_ADMIN_PASSWORD=
